{
  "name": "jieti",
  "version": "0.1.1",
  "description": "Personal study tutor and learning journal",
  "author": "Jieti",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "npm run generate && tsc --noEmit && vite build && node scripts/build-electron.mjs",
    "desktop": "electron .",
    "test": "tsx --test tests/*.test.ts",
    "package": "npm run build && electron-builder --win nsis zip --x64",
    "verify": "npm run build && npm test"
  },
  "main": "dist/electron/main.cjs",
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "rehype-katex": "^7.0.1",
    "katex": "^0.16.22",
    "marked": "^15.0.12",
    "dompurify": "^3.2.6",
    "lucide-react": "^0.468.0",
    "sql.js": "^1.13.0",
    "qrcode": "^1.5.4",
    "node-forge": "^1.3.1",
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "@vitejs/plugin-react": "^4.4.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/node": "^22.15.0",
    "@types/sql.js": "^1.4.9",
    "@types/qrcode": "^1.5.5",
    "@types/node-forge": "^1.3.11",
    "electron": "44.4.5",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.5",
    "tsx": "^4.19.4"
  },
  "build": {
    "appId": "cn.jieti.desktop",
    "productName": "截题",
    "directories": {
      "output": "release/windows"
    },
    "files": [
      "dist/**/*",
      "node_modules/sql.js/dist/sql-wasm.wasm"
    ],
    "asarUnpack": [
      "**/*.wasm"
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "signExecutable": false,
      "icon": "assets/brand/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "artifactName": "Jieti-${version}-${arch}.${ext}"
  }
}
